{
  "name": "YouTube Time Warning",
  "version": "0.1.0",
  "description": "Shows a red border that intensifies the longer you watch YouTube",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["contentScript.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Time Warning"
  },
  "manifest_version": 3
}
